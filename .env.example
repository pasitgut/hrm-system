# Copy this file to .env and set local connection details and a strong session secret.
# Production (Vercel + Supabase):
#   IMPORTANT: Vercel runs on IPv4 networks, whereas Supabase Direct host (`db.<ref>.supabase.co:5432`)
#   is IPv6-only unless the IPv4 add-on is enabled. Use Supabase Pooler hosts (`*.pooler.supabase.com`)
#   with username `postgres.<project-ref>`:
#   - DATABASE_URL: Supabase Transaction Pooler (`aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true`)
#   - DIRECT_DATABASE_URL: Supabase Session Pooler (`aws-0-<region>.pooler.supabase.com:5432/postgres`) for Drizzle migrations
DATABASE_URL=postgresql://user:password@localhost:5432/hrm_system
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/hrm_system_test
# Optional: Session Pooler / unpooled connection used for auto-migrations on startup and `npm run db:migrate`.
DIRECT_DATABASE_URL=
JWT_SECRET=replace-this-with-a-long-random-secret
SESSION_COOKIE_NAME=hrm_session
# Built-in system admin account (no DB user row required).
# Leave ADMIN_PASSWORD unset to use the default password "admin" for initial setup, and set a strong value in production.
ADMIN_PASSWORD=
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@peopleos.co
# API Checker credentials used only by the server-side work tracking route.
CHECKER_API_EMAIL=
CHECKER_API_PASSWORD=
# Google Drive OAuth credentials. The app creates an "HRM Employee Documents" folder on first upload.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Server-only Cloudinary credentials for image and signature uploads (avatars, assets, signatures, agreements).
# Either set these three variables or a single CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LINE Bot: keep disabled until migration 0029, provider credentials and the recovery scheduler are ready.
LINE_BOT_ENABLED=false
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Separate random bearer secret for POST /api/internal/integrations/retry (server-side scheduler only).
LINE_INTEGRATION_SECRET=
# Calendar uses a service account shared onto this specific calendar, not personal OAuth/Drive credentials.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PKCS8 private key; escaped \n sequences are accepted. Never commit the actual value or JSON key file.
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

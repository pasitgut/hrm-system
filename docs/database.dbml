Project hrm_system {
  database_type: 'PostgreSQL'
  Note: '''
    HRM System PostgreSQL Schema (24 tables, 8 enums)
    Source of truth: lib/db/schema.ts
    - RLS is enabled on all 24 public tables in Supabase.
    - Binary employee documents (up to 50 MB) are stored in Google Drive (drive_file_id reference only).
    - Images (avatars, asset attachments, HTML signature/agreement images) are stored in Cloudinary (secure URLs only).
  '''
}

// ============================================================================
// Enums (8)
// ============================================================================

Enum asset_request_status {
  pending
  approved
  rejected
  return_pending
  returned
  unknown
}

Enum asset_agreement_status {
  waiting_handover
  waiting_employee
  waiting_admin
  completed
}

Enum asset_agreement_type {
  borrow
  asset_form
}

Enum asset_agreement_participant {
  employee
  handover
  admin
}

Enum asset_signer_kind {
  employee
  admin
  other
}

Enum asset_signature_status {
  pending
  signed
  locked
}

Enum asset_return_condition {
  original
  damaged
  lost
}

Enum asset_attachment_kind {
  request
  additional
  return
}

// ============================================================================
// 1. Master & Lookup Tables (7)
// ============================================================================

Table departments {
  id integer [pk, increment]
  name varchar(255) [not null, unique]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table positions {
  id integer [pk, increment]
  name varchar(255) [not null, unique]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table employment_statuses {
  id smallint [pk, increment]
  name varchar(100) [not null, unique]
  is_active boolean [not null, default: true]
}

Table employment_types {
  id smallint [pk, increment]
  code varchar(30) [not null, unique]
  name varchar(100) [not null, unique]
  is_active boolean [not null, default: true]
}

Table request_statuses {
  code varchar(20) [pk]
  name varchar(100) [not null, unique]
}

Table ot_rate_settings {
  id integer [pk, default: 1]
  weekday_multiplier numeric(5,2) [not null, default: 1.5]
  holiday_multiplier numeric(5,2) [not null, default: 3]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Singleton row: CHECK (id = 1 AND weekday_multiplier > 0 AND weekday_multiplier <= 10 AND holiday_multiplier > 0 AND holiday_multiplier <= 10)'
}

Table leave_types {
  code varchar(30) [pk, default: `nextval('leave_type_code_seq')::text`]
  name varchar(100) [not null, unique]
  description text
  annual_quota_days integer
  quota_basis varchar(20) [not null, default: 'fixed']
  is_active boolean [not null, default: true]

  Note: "CHECK (quota_basis IN ('fixed', 'tenure'))"
}

// ============================================================================
// 2. HR Core, Auth & Employee Documents (3)
// ============================================================================

Table employees {
  id uuid [pk]
  code varchar(4) [not null, unique]
  prefix varchar(20)
  first_name varchar(255) [not null]
  last_name varchar(255) [not null]
  base_salary numeric(12,2)
  payroll_data jsonb [not null, default: '{}']
  ot_weekday_multiplier numeric(5,2) [not null, default: 1.5]
  ot_holiday_multiplier numeric(5,2) [not null, default: 3]
  work_hours_per_day numeric(5,2) [not null, default: 8]
  weekly_holidays "integer[]" [not null, default: '{}', note: 'CHECK (weekly_holidays <@ ARRAY[0,1,2,3,4,5,6])']
  nickname varchar(100)
  citizen_id varchar(20) [unique]
  first_name_en varchar(255)
  last_name_en varchar(255)
  birth_date date
  email varchar(255) [unique]
  phone varchar(30)
  avatar_url text [note: 'Cloudinary secure URL (legacy ImgBB URLs auto-migrate on read/write)']
  line_uid varchar(64) [unique]
  start_date date [not null]
  end_date date
  department_id integer
  position_id integer
  employment_status_id smallint
  employment_type_id smallint
  manager_id uuid
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'CHECK (char_length(code) = 4), CHECK (end_date IS NULL OR end_date >= start_date), CHECK (base_salary IS NULL OR base_salary >= 0), CHECK (work_hours_per_day > 0 AND work_hours_per_day <= 24), CHECK (ot multipliers 0..10)'

  indexes {
    department_id
    position_id
    employment_status_id
    employment_type_id
    manager_id
  }
}

Table users {
  id uuid [pk]
  employee_id uuid [not null, unique]
  email varchar(255) [not null, unique]
  password_hash text [not null]
  must_change_password boolean [not null, default: false]
  role varchar(20) [not null, default: 'employee', note: "CHECK (role IN ('employee', 'hr', 'executive'))"]
  permissions jsonb [not null, default: '[]']
  is_active boolean [not null, default: true]
  last_login_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table employee_documents {
  id uuid [pk]
  employee_id uuid [not null]
  file_name text [not null]
  mime_type varchar(127) [not null]
  file_size integer [not null, note: 'CHECK (file_size > 0 AND file_size <= 52428800) - max 50 MB']
  drive_file_id text [not null, unique, note: 'Google Drive file ID (chunked resumable upload)']
  shared_with_user_ids "uuid[]" [not null, default: '{}']
  uploaded_by_user_id uuid
  created_at timestamptz [not null]

  indexes {
    (employee_id, created_at)
    drive_file_id [unique]
  }
}

// ============================================================================
// 3. Leave & Overtime Requests (2)
// ============================================================================

Table leave_requests {
  id uuid [pk]
  employee_id uuid [not null]
  leave_type_code varchar(30) [not null]
  start_on date [not null]
  end_on date [not null]
  session varchar(10) [not null, default: 'full']
  reason text
  attachment_url text [note: 'Cloudinary URL (legacy ImgBB URLs auto-migrate on read/write)']
  status_code varchar(20) [not null, default: 'pending']
  decided_by_employee_id uuid
  decided_at timestamptz
  decision_note text
  cancelled_by_employee_id uuid
  cancelled_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (employee_id, start_on, end_on)
    (status_code, start_on)
    leave_type_code
    decided_by_employee_id
  }

  Note: "CHECK (end_on >= start_on), CHECK (session IN ('full', 'am', 'pm')), CHECK (session = 'full' OR start_on = end_on)"
}

Table overtime_requests {
  id uuid [pk]
  employee_id uuid [not null]
  start_at timestamptz [not null]
  end_at timestamptz [not null]
  reason text [not null]
  source varchar(30) [not null, default: 'hrm', note: "CHECK (source IN ('hrm', 'line_bot')) AND CHECK (end_at > start_at)"]
  line_day_key text
  line_request_ids "text[]" [not null, default: '{}']
  status_code varchar(20) [not null, default: 'pending']
  decided_by_employee_id uuid
  decided_at timestamptz
  decision_note text
  cancelled_by_employee_id uuid
  cancelled_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (employee_id, start_at)
    (status_code, start_at)
    decided_by_employee_id
    (source, line_day_key, status_code)
  }
}

// ============================================================================
// 4. Asset Borrowing & E-Agreements (8)
// ============================================================================

Table asset_requests {
  id uuid [pk]
  agreement_id uuid [unique]
  legacy_sheet_id text [unique]
  borrower_employee_id uuid [not null]
  borrower_employee_code varchar(4) [not null, note: 'CHECK (char_length(borrower_employee_code) = 4)']
  borrower_name varchar(255) [not null]
  borrower_department varchar(255) [not null, default: '']
  borrower_position varchar(255) [not null, default: '']
  form_date timestamptz [not null]
  from_date date [not null]
  to_date date
  reason text [not null, default: '']
  remarks text [not null, default: '']
  status asset_request_status [not null, default: 'pending']
  approved_borrow_by_employee_id uuid
  approved_borrow_by_name varchar(255) [not null, default: '']
  approved_borrow_at timestamptz
  borrower_signature_data text [not null, default: '', note: 'Cloudinary URL or legacy ImgBB URL auto-migrated on read/write']
  approved_borrow_signature_data text [not null, default: '', note: 'Cloudinary URL or legacy ImgBB URL auto-migrated on read/write']
  return_inspector_employee_id uuid
  return_inspector_name varchar(255) [not null, default: '']
  approved_return_by_employee_id uuid
  approved_return_by_name varchar(255) [not null, default: '']
  return_inspection text
  version integer [not null, default: 1]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  deleted_by_employee_id uuid

  indexes {
    (borrower_employee_id, created_at)
    (status, created_at)
    agreement_id [unique]
    legacy_sheet_id [unique]
  }
}

Table asset_request_items {
  request_id uuid [not null]
  position smallint [not null]
  name text [not null]
  quantity integer [not null, default: 1]
  note text [not null, default: '']

  indexes {
    (request_id, position) [pk]
  }
}

Table asset_request_attachments {
  id uuid [pk]
  request_id uuid [not null]
  kind asset_attachment_kind [not null]
  position smallint [not null, default: 0]
  url text [not null, note: 'Cloudinary URL (legacy ImgBB URLs auto-migrate on read/write)']
  uploaded_by_employee_id uuid
  created_at timestamptz [not null]

  indexes {
    (request_id, kind)
    (request_id, kind, position) [unique]
  }
}

Table asset_agreement_templates {
  id uuid [pk]
  type asset_agreement_type [not null, default: 'borrow']
  title text [not null]
  header_html text [not null, default: '']
  body_html text [not null]
  footer_html text [not null, default: '']
  is_active boolean [not null, default: true]
  created_by_employee_id uuid
  created_by_name varchar(255) [not null, default: '']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version integer [not null, default: 1]

  indexes {
    (is_active, type)
  }
}

Table asset_agreements {
  id uuid [pk]
  template_id uuid
  type asset_agreement_type [not null, default: 'borrow']
  title text [not null]
  header_html text [not null, default: '']
  body_html text [not null]
  footer_html text [not null, default: '']
  status asset_agreement_status [not null]
  created_by_employee_id uuid
  created_by_name varchar(255) [not null, default: '']
  created_by_employee_code varchar(4) [not null, default: '', note: "CHECK (created_by_employee_code = '' OR char_length(created_by_employee_code) = 4)"]
  return_condition asset_return_condition
  document_date date [not null]
  updated_at timestamptz
  version integer [not null, default: 1]
}

Table asset_agreement_signers {
  agreement_id uuid [not null]
  box_id varchar(100) [not null]
  position smallint [not null]
  participant asset_agreement_participant [not null]
  label varchar(255) [not null]
  role varchar(255) [not null]
  signer_kind asset_signer_kind [not null]
  signer_name varchar(255) [not null, default: '']
  layout_position varchar(30) [not null]
  page smallint
  x_percent numeric(5,2)
  y_percent numeric(5,2)
  signature_data text [note: 'Cloudinary URL or signature data (ImgBB URLs auto-migrate)']
  signature_status asset_signature_status [not null]
  signed_by_employee_id uuid
  signed_by_name varchar(255) [not null, default: '']
  signed_at timestamptz
  return_signature_data text [note: 'Cloudinary URL or signature data (ImgBB URLs auto-migrate)']
  return_signed_by_employee_id uuid
  return_signed_by_name varchar(255) [not null, default: '']
  return_signed_at timestamptz

  indexes {
    (agreement_id, box_id) [pk]
    (participant, agreement_id)
  }
}

Table asset_request_reads {
  request_id uuid [not null]
  employee_id uuid [not null]
  seen_at timestamptz [not null]

  indexes {
    (request_id, employee_id) [pk]
  }
}

Table asset_request_events {
  id bigint [pk, increment]
  request_id uuid [not null]
  actor_employee_id uuid
  event_type varchar(100) [not null]
  from_status asset_request_status
  to_status asset_request_status
  details jsonb [not null, default: '{}']
  created_at timestamptz [not null]

  indexes {
    (request_id, created_at)
  }
}

// ============================================================================
// 5. LINE Bot & Work Tracking (4)
// ============================================================================

Table work_tracking_records {
  id uuid [pk]
  house_no varchar(120) [not null]
  round varchar(40) [not null]
  event_date date [not null]
  project_text text [not null, default: '']
  detail text [not null, default: '']
  status varchar(20) [not null, default: 'in_progress']
  delivered_date date
  report_statuses jsonb [not null, default: '{}']
  sub_statuses jsonb [not null, default: '[]']
  workers jsonb [not null, default: '{}']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (house_no, round, event_date) [unique]
    event_date
  }
}

Table line_webhook_events {
  event_id text [pk]
  source_id text
  status text [not null]
  attempts integer [not null, default: 1]
  lease_until timestamptz
  sheet_committed boolean [not null, default: false]
  response_payload jsonb
  error_code text
  push_retry_key uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (status, lease_until)
  }
}

Table work_tracking_requests {
  request_id text [pk]
  work_tracking_record_id uuid
  event_date date [not null]
  work_date date [not null]
  house_no varchar(120) [not null]
  round varchar(40) [not null]
  inspect_no varchar(64)
  project_short_name text [not null, default: '']
  developer_note text [not null, default: '']
  latest_status varchar(20) [not null, default: 'in_progress']
  status_source varchar(20) [not null, default: 'default']
  checker_request_status varchar(20)
  latest_employee_id uuid
  latest_employee_code varchar(4) [not null, note: "CHECK (latest_employee_code = '' OR char_length(latest_employee_code) = 4)"]
  latest_employee_name varchar(255) [not null]
  latest_start_time varchar(10) [not null]
  latest_end_time varchar(10) [not null]
  latest_action text [not null, default: '']
  is_ot boolean [not null, default: false]
  last_event_id text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (house_no, round, event_date)
    work_tracking_record_id
    work_date
  }
}

Table work_tracking_activities {
  activity_id text [pk]
  request_id text [not null]
  work_tracking_record_id uuid
  overtime_request_id uuid
  employee_id uuid
  employee_code varchar(4) [not null, note: "CHECK (employee_code = '' OR char_length(employee_code) = 4)"]
  employee_name varchar(255) [not null]
  event_date date [not null]
  work_date date [not null]
  start_time varchar(10) [not null]
  end_time varchar(10) [not null]
  house_no varchar(120) [not null]
  round varchar(40) [not null]
  inspect_no varchar(64)
  project_short_name text [not null, default: '']
  developer_note text [not null, default: '']
  action text [not null, default: '']
  status varchar(20) [not null]
  status_source varchar(20) [not null]
  is_ot boolean [not null, default: false]
  event_id text [not null]
  recorded_at timestamptz [not null]

  indexes {
    (request_id, recorded_at)
    event_id
    overtime_request_id
    work_tracking_record_id
  }
}

// ============================================================================
// TableGroups (Logical Domains)
// ============================================================================

TableGroup master_lookups {
  departments
  positions
  employment_statuses
  employment_types
  request_statuses
  ot_rate_settings
  leave_types
}

TableGroup hr_and_auth {
  employees
  users
  employee_documents
}

TableGroup leave_and_overtime {
  leave_requests
  overtime_requests
}

TableGroup asset_borrowing {
  asset_requests
  asset_request_items
  asset_request_attachments
  asset_agreement_templates
  asset_agreements
  asset_agreement_signers
  asset_request_reads
  asset_request_events
}

TableGroup line_and_work_tracking {
  work_tracking_records
  line_webhook_events
  work_tracking_requests
  work_tracking_activities
}

// ============================================================================
// Relationships
// ============================================================================

// Employees & Auth
Ref: employees.department_id > departments.id [delete: set null]
Ref: employees.position_id > positions.id [delete: set null]
Ref: employees.employment_status_id > employment_statuses.id [delete: set null]
Ref: employees.employment_type_id > employment_types.id [delete: set null]
Ref: employees.manager_id > employees.id
Ref: users.employee_id - employees.id
Ref: employee_documents.employee_id > employees.id [delete: cascade]
Ref: employee_documents.uploaded_by_user_id > users.id [delete: set null]

// Leave Requests
Ref: leave_requests.employee_id > employees.id
Ref: leave_requests.leave_type_code > leave_types.code
Ref: leave_requests.status_code > request_statuses.code
Ref: leave_requests.decided_by_employee_id > employees.id
Ref: leave_requests.cancelled_by_employee_id > employees.id

// Overtime Requests
Ref: overtime_requests.employee_id > employees.id
Ref: overtime_requests.status_code > request_statuses.code
Ref: overtime_requests.decided_by_employee_id > employees.id
Ref: overtime_requests.cancelled_by_employee_id > employees.id

// Asset Borrowing & Agreements
Ref: asset_requests.agreement_id - asset_agreements.id [delete: set null]
Ref: asset_requests.borrower_employee_id > employees.id [delete: restrict]
Ref: asset_requests.approved_borrow_by_employee_id > employees.id [delete: set null]
Ref: asset_requests.return_inspector_employee_id > employees.id [delete: set null]
Ref: asset_requests.approved_return_by_employee_id > employees.id [delete: set null]
Ref: asset_requests.deleted_by_employee_id > employees.id [delete: set null]

Ref: asset_request_items.request_id > asset_requests.id [delete: cascade]
Ref: asset_request_attachments.request_id > asset_requests.id [delete: cascade]
Ref: asset_request_attachments.uploaded_by_employee_id > employees.id [delete: set null]

Ref: asset_agreement_templates.created_by_employee_id > employees.id [delete: set null]
Ref: asset_agreements.template_id > asset_agreement_templates.id [delete: set null]
Ref: asset_agreements.created_by_employee_id > employees.id [delete: set null]

Ref: asset_agreement_signers.agreement_id > asset_agreements.id [delete: cascade]
Ref: asset_agreement_signers.signed_by_employee_id > employees.id [delete: set null]
Ref: asset_agreement_signers.return_signed_by_employee_id > employees.id [delete: set null]

Ref: asset_request_reads.request_id > asset_requests.id [delete: cascade]
Ref: asset_request_reads.employee_id > employees.id [delete: cascade]

Ref: asset_request_events.request_id > asset_requests.id [delete: restrict]
Ref: asset_request_events.actor_employee_id > employees.id [delete: set null]

// Work Tracking & LINE Integration
Ref: work_tracking_requests.work_tracking_record_id > work_tracking_records.id [delete: set null]
Ref: work_tracking_requests.latest_employee_id > employees.id [delete: set null]

Ref: work_tracking_activities.request_id > work_tracking_requests.request_id [delete: cascade]
Ref: work_tracking_activities.work_tracking_record_id > work_tracking_records.id [delete: set null]
Ref: work_tracking_activities.overtime_request_id > overtime_requests.id [delete: set null]
Ref: work_tracking_activities.employee_id > employees.id [delete: set null]
